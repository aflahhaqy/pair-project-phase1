<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Foodies</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    .merchant-card img {
      height: 180px;
      object-fit: cover;
    }
    .food-card img {
      height: 150px;
      object-fit: cover;
    }
  </style>
</head>
<body>

  <!-- Navbar -->
  <nav class="navbar navbar-expand-lg navbar-light bg-light shadow-sm sticky-top">
    <div class="container">
      <a class="navbar-brand fw-bold text-success" href="#">Foodies</a>
      <form class="d-flex ms-auto me-3">
        <input class="form-control me-2" type="search" placeholder="Cari makanan atau restoran">
        <button class="btn btn-outline-success" type="submit">Cari</button>
      </form>
      <button class="btn btn-success">Login</button>
    </div>
  </nav>

  <!-- Hero -->
  <section class="bg-success text-white text-center p-5">
    <div class="container">
      <h1 class="fw-bold">Pesan makanan favoritmu di Pondok Indah</h1>
      <p class="lead">Cepat, mudah, dan praktis langsung dari merchant terdekat</p>
      <button class="btn btn-light btn-lg text-success fw-bold">Lihat Restoran</button>
    </div>
  </section>

  <!-- Merchants -->
   <!-- <%= JSON.stringify(data) %> -->
  <section class="container py-5">
    <h2 class="mb-4 fw-bold">Restoran Terdekat</h2>
    <div class="row g-4">
      <div class="col-md-3">
        <div class="card merchant-card shadow-sm">
          <img src="https://example.com/images/warung-sate-pondok.jpg" class="card-img-top" alt="Warung Sate Pondok">
          <div class="card-body">
            <h5 class="card-title">Warung Sate Pondok</h5>
            <p class="card-text">Jl. Metro Pondok Indah No. 10</p>
            <a href="#" class="btn btn-success btn-sm">Lihat Menu</a>
          </div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="card merchant-card shadow-sm">
          <img src="https://example.com/images/bakmi-enak-pim.jpg" class="card-img-top" alt="Bakmi Enak PIM">
          <div class="card-body">
            <h5 class="card-title">Bakmi Enak PIM</h5>
            <p class="card-text">Pondok Indah Mall 2</p>
            <a href="#" class="btn btn-success btn-sm">Lihat Menu</a>
          </div>
        </div>
      </div>
      <!-- Tambahkan merchant lainnya -->
    </div>
  </section>

  <!-- Beverages -->
  <section class="container py-5">
    <h2 class="mb-4 fw-bold">Minuman Favorit</h2>
    <div class="row g-4">
      <div class="col-md-3">
        <div class="card food-card shadow-sm">
          <img src="https://example.com/images/es-kopi-susu.jpg" class="card-img-top" alt="Es Kopi Susu">
          <div class="card-body">
            <h5 class="card-title">Es Kopi Susu Gula Aren</h5>
            <p class="card-text">Rp 22.000</p>
            <button class="btn btn-success btn-sm">Tambah</button>
          </div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="card food-card shadow-sm">
          <img src="https://example.com/images/teh-botol.jpg" class="card-img-top" alt="Teh Botol">
          <div class="card-body">
            <h5 class="card-title">Teh Botol Sosro</h5>
            <p class="card-text">Rp 7.000</p>
            <button class="btn btn-success btn-sm">Tambah</button>
          </div>
        </div>
      </div>
      <!-- Tambahkan beverages lainnya -->
    </div>
  </section>

  <footer class="bg-light text-center p-4 mt-5">
    <p class="mb-0">&copy; 2025 Foodies - Pair-Project HCK88 P1</p>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>